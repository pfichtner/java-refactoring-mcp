[109.915579, "o", "\r\n======================================================================\r\nFinal state of the codebase\r\n======================================================================\r\n"]
[109.917556, "o", "\r\n### AgedBrieUpdater.java\r\n\r\n"]
[109.922645, "o", "package gildedrose;\r\n\r\npublic final class AgedBrieUpdater implements ItemUpdater {\r\n\r\n    @Override\r\n    public boolean canHandle(Item item) {\r\n        return \"Aged Brie\".equals(item.name);\r\n    }\r\n\r\n    @Override\r\n    public void update(Item item) {\r\n        if (item.quality < 50) {\r\n            item.quality = item.quality + 1;\r\n        }\r\n        item.sellIn = item.sellIn - 1;\r\n        if (item.sellIn < 0) {\r\n            if (item.quality < 50) {\r\n                item.quality = item.quality + 1;\r\n            }\r\n        }\r\n    }\r\n}\r\n\r\n### BackstagePassUpdater.java\r\n\r\n"]
[109.923491, "o", "package gildedrose;\r\n\r\npublic final class BackstagePassUpdater implements ItemUpdater {\r\n\r\n    @Override\r\n"]
[109.923761, "o", "    public boolean canHandle(Item item) {\r\n        return \"Backstage passes to a TAFKAL80ETC concert\".equals(item.name);\r\n    }\r\n\r\n    @Override\r\n    public void update(Item item) {\r\n        if (item.quality < 50) {\r\n            item.quality = item.quality + 1;\r\n            if (item.sellIn < 11) {\r\n                if (item.quality < 50) {\r\n                    item.quality = item.quality + 1;\r\n                }\r\n            }\r\n            if (item.sellIn < 6) {\r\n                if (item.quality < 50) {\r\n                    item.quality = item.quality + 1;\r\n                }\r\n            }\r\n        }\r\n        item.sellIn = item.sellIn - 1;\r\n        if (item.sellIn < 0) {\r\n            item.quality = item.quality - item.quality;\r\n        }\r\n    }\r\n}\r\n\r\n### GildedRose.java\r\n\r\n"]
[109.925628, "o", "package gildedrose;\r\n\r\nimport java.util.List;\r\n\r\npublic class GildedRose {\r\n\r\n    private final List<ItemUpdater> chain = List.of(\r\n            new AgedBrieUpdater(),"]
[109.925756, "o", "\r\n            new BackstagePassUpdater(),\r\n            new SulfurasUpdater(),\r\n            new RegularUpdater());\r\n\r\n    Item[] items;\r\n\r\n    public GildedRose(Item[] items) {\r\n        this.items = items;\r\n    }\r\n\r\n    public void updateQuality() {\r\n        for (int i = 0; i < items.length; i++) {\r\n            apply(items[i]);\r\n        }\r\n    }\r\n\r\n    private void apply(Item item) {\r\n        for (ItemUpdater updater : chain) {\r\n            if (updater.canHandle(item)) {\r\n                updater.update(item);\r\n                return;\r\n"]
[109.926186, "o", "            }\r\n        }\r\n        throw new IllegalStateException(\"No updater for item: \" + item.name);\r\n"]
[109.926293, "o", "    }\r\n}\r\n\r\n\r\n### Item.java\r\n\r\n"]
[109.928204, "o", "package gildedrose;\r\n\r\npublic class Item {\r\n\r\n    public String name;"]
[109.928327, "o", "\r\n\r\n    public int sellIn;\r\n\r\n    public int quality;\r\n\r\n    public Item(String name, int sellIn, int quality) {\r\n        this.name = name;\r\n        this.sellIn = sellIn;\r\n        this.quality = quality;\r\n    }\r\n\r\n    @Override\r\n    public String toString() {\r\n        return this.name + \", \" + this.sellIn + \", \" + this.quality;\r\n    }\r\n}\r\n\r\n"]
[109.928344, "o", "### ItemUpdater.java\r\n\r\n"]
[109.933465, "o", "package gildedrose;\r\n\r\npublic interface ItemUpdater {\r\n\r\n    boolean canHandle(Item item);\r\n\r\n    void update(Item item);\r\n"]
[109.933516, "o", "}\r\n\r\n\r\n### RegularUpdater.java\r\n\r\n"]
[109.936392, "o", "package gildedrose;\r\n\r\npublic final class RegularUpdater implements ItemUpdater {\r\n\r\n    @Override\r\n    public boolean canHandle(Item item) {\r\n        return true;\r\n    }\r\n\r\n    @Override\r\n    public void update(Item item) {"]
[109.936437, "o", "\r\n        if (item.quality > 0) {\r\n            item.quality = item.quality - 1;\r\n        }\r\n        item.sellIn = item.sellIn - 1;\r\n        if (item.sellIn < 0) {\r\n            if (item.quality > 0) {"]
[109.936449, "o", "\r\n                item.quality = item.quality - 1;\r\n            }"]
[109.93646, "o", "\r\n        }\r\n"]
[109.936471, "o", "    }"]
[109.936481, "o", "\r\n}"]
[109.936659, "o", "\r\n\r\n"]
[109.936677, "o", "### SulfurasUpdater.java\r\n"]
[109.936687, "o", "\r\n"]
[109.939423, "o", "package gildedrose;"]
[109.939692, "o", "\r\n\r\npublic final class SulfurasUpdater implements ItemUpdater {\r\n\r\n    @Override\r\n    public boolean canHandle(Item item) {\r\n        return \"Sulfuras, Hand of Ragnaros\".equals(item.name);\r\n    }\r\n\r\n"]
[109.940094, "o", "    @Override\r\n    public void update(Item item) {\r\n    }\r\n}\r\n\r\n### TexttestFixture.java\r\n\r\n"]
[109.942143, "o", "package gildedrose;"]
[109.942631, "o", "\r\n\r\npublic class TexttestFixture {\r\n\r\n    public static void main(String[] args) {\r\n        Item[] items = new Item[] {\r\n                new Item(\"+5 Dexterity Vest\", 10, 20),\r\n                new Item(\"Aged Brie\", 2, 0),\r\n                new Item(\"Elixir of the Mongoose\", 5, 7),\r\n                new Item(\"Sulfuras, Hand of Ragnaros\", 0, 80),\r\n                new Item(\"Sulfuras, Hand of Ragnaros\", -1, 80),\r\n                new Item(\"Backstage passes to a TAFKAL80ETC concert\", 15, 20),\r\n                new Item(\"Backstage passes to a TAFKAL80ETC concert\", 10, 49),\r\n                new Item(\"Backstage passes to a TAFKAL80ETC concert\", 5, 49),\r\n                new Item(\"Conjured Mana Cake\", 3, 6)\r\n        };\r\n\r\n        GildedRose app = new GildedRose(items);\r\n\r\n        int days = 2;\r\n        if (args.length > 0) {\r\n            days = Integer.parseInt(args[0]) + 1;"]
[109.944359, "o", "\r\n        }\r\n\r\n        for (int i = 0; i < days; i++) {\r\n            System.out.println(\"-------- day \" + i + \" --------\");\r\n            System.out.println(\"name, sellIn, quality\");\r\n            for (Item item : items) {\r\n                System.out.println(item);\r\n            }\r\n            System.out.println();\r\n            app.updateQuality();\r\n        }\r\n    }\r\n}\r\n\r\n======================================================================\r\nDONE · every milestone green; Gilded Rose now runs as a chain of responsibility\r\n======================================================================\r\n"]
